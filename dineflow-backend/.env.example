APP_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=dineflow
DB_SSLMODE=disable

JWT_SECRET=change-me-in-production

# "mock" (default) needs nothing else and lets you exercise the whole QRIS
# flow locally. Switch to "midtrans" + a real sandbox Server Key once you
# want to test against the actual gateway.
PAYMENT_GATEWAY=mock
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
